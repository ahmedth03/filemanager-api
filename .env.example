# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=harfidar
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=harfidar_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://harfidar:change_me_in_production@localhost:5432/harfidar_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_redis_password

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:8080

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_very_long_random_secret_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_another_very_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# ── Cloudinary (image storage) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── SMTP (email — use Gmail, SendGrid, Mailgun, etc.) ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=HarfiDar <noreply@harfidar.dz>

# ── Firebase Admin (push notifications) ───────────────────────────────────────
# Option A: path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=/secrets/firebase-service-account.json
# Option B: individual credentials (use one or the other, not both)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ── Rate limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── Admin defaults (seed only) ────────────────────────────────────────────────
ADMIN_EMAIL=admin@harfidar.dz
ADMIN_PASSWORD=Admin@123456

# ── PgAdmin (dev only) ────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@harfidar.dz
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050
